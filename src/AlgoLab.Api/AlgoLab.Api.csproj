<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\AlgoLab.Problems\AlgoLab.Problems.csproj" />
    <ProjectReference Include="..\AlgoLab.Runner\AlgoLab.Runner.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets AlgoLab.Tests exercise RunnerHost.ParsePayload directly, without spawning a process. -->
    <InternalsVisibleTo Include="AlgoLab.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <SpaRoot>web\</SpaRoot>
    <SpaProxyServerUrl>http://localhost:5173</SpaProxyServerUrl>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned explicitly: an unversioned `dotnet add package` here resolves a net10.0-only build,
         which breaks this net9.0 solution and Visual Studio 2022. -->
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="9.0.19" />
  </ItemGroup>

  <ItemGroup>
    <!-- Without this the SDK tries to pack node_modules into the publish output. -->
    <Content Remove="web\**" />
    <None Include="web\**" Exclude="web\node_modules\**;web\dist\**" />
  </ItemGroup>

</Project>
